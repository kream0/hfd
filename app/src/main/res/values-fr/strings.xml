    <string name="tajweed_title">Tajwīd</string>
    <string name="tajweed_body">Les lettres prennent la couleur de leur règle, comme dans les muṣḥafs de tajwīd. Lecture de Ḥafṣ d\'après ʿĀṣim.</string>
    <string name="tajweed_switch">Lettres en couleurs</string>
    <string name="tajweed_note">Les règles sont lues dans le texte uthmani lui-même (texte de Tanzil, inchangé) : seule la couleur s\'ajoute. Le verset est lu d\'un seul souffle jusqu\'à sa fin, où la lecture s\'arrête.</string>
    <string name="tajweed_of_aya">Tajwīd de ce verset</string>
    <string name="tajweed_none">Aucune règle particulière dans ce verset.</string>
    <string name="tajweed_open">Couleurs du tajwīd</string>
    <string name="settings_tajweed">Couleurs du tajwīd</string>
    <string name="settings_tajweed_body">Chaque règle a sa couleur ; choisissez celles à montrer.</string>
    <string name="settings_tajweed_choose">Choisir</string>
    <string name="tajweed_family_madd6">Madd de 6 temps</string>
    <string name="tajweed_family_madd6_body">Madd lāzim : avant une lettre sans voyelle ou doublée, et les lettres isolées.</string>
    <string name="tajweed_family_madd45">Madd de 4 ou 5 temps</string>
    <string name="tajweed_family_madd45_body">Avant une hamza, dans le mot (muttaṣil) ou au début du suivant (munfaṣil).</string>
    <string name="tajweed_family_madd246">Madd de 2, 4 ou 6 temps</string>
    <string name="tajweed_family_madd246_body">Avant la lettre où le verset s\'arrête (ʿāriḍ, līn).</string>
    <string name="tajweed_family_madd2">Madd de 2 temps</string>
    <string name="tajweed_family_madd2_body">Voyelle longue écrite par une petite lettre : alif suscrit, petit wāw, petit yāʾ.</string>
    <string name="tajweed_family_ghunnah">Ghunna, ikhfāʾ, iqlāb</string>
    <string name="tajweed_family_ghunnah_body">Son nasal tenu deux temps.</string>
    <string name="tajweed_family_qalqalah">Qalqala</string>
    <string name="tajweed_family_qalqalah_body">ق ط ب ج د sans voyelle : la lettre rebondit.</string>
    <string name="tajweed_family_tafkhim">Tafkhīm</string>
    <string name="tajweed_family_tafkhim_body">Le rāʾ emphatique, et le lām du Nom après a ou u.</string>
    <string name="tajweed_family_silent">Non prononcé</string>
    <string name="tajweed_family_silent_body">Lettre fondue dans la suivante (idghām), alif de liaison, lettres écrites et non lues.</string>
    <string name="tajweed_ghunnah">Ghunna</string>
    <string name="tajweed_ghunnah_body">Nūn ou mīm doublé : nasaliser deux temps.</string>
    <string name="tajweed_ikhfa">Ikhfāʾ</string>
    <string name="tajweed_ikhfa_body">Nūn sans voyelle ou tanwīn caché devant la lettre suivante, avec une ghunna de deux temps.</string>
    <string name="tajweed_ikhfa_shafawi">Ikhfāʾ shafawī</string>
    <string name="tajweed_ikhfa_shafawi_body">Mīm sans voyelle cachée devant bāʾ, avec ghunna.</string>
    <string name="tajweed_iqlab">Iqlāb</string>
    <string name="tajweed_iqlab_body">Nūn sans voyelle ou tanwīn changé en mīm devant bāʾ, avec ghunna.</string>
    <string name="tajweed_idgham_ghunnah">Idghām avec ghunna</string>
    <string name="tajweed_idgham_ghunnah_body">Nūn sans voyelle ou tanwīn fondu dans ي ن م و, avec une ghunna de deux temps.</string>
    <string name="tajweed_idgham_no_ghunnah">Idghām sans ghunna</string>
    <string name="tajweed_idgham_no_ghunnah_body">Nūn sans voyelle ou tanwīn fondu dans ل ou ر, sans ghunna.</string>
    <string name="tajweed_idgham_shafawi">Idghām shafawī</string>
    <string name="tajweed_idgham_shafawi_body">Mīm sans voyelle fondue dans le mīm suivant, avec ghunna.</string>
    <string name="tajweed_idgham_mutamathilayn">Idghām de deux lettres identiques</string>
    <string name="tajweed_idgham_mutamathilayn_body">Mutamāthilayn : la première se fond dans la seconde, doublée.</string>
    <string name="tajweed_idgham_mutajanisayn">Idghām de deux lettres de même articulation</string>
    <string name="tajweed_idgham_mutajanisayn_body">Mutajānisayn : la première se fond dans la seconde.</string>
    <string name="tajweed_idgham_mutaqaribayn">Idghām de deux lettres proches</string>
    <string name="tajweed_idgham_mutaqaribayn_body">Mutaqāribayn : la première se fond dans la seconde.</string>
    <string name="tajweed_qalqalah">Qalqala</string>
    <string name="tajweed_qalqalah_body">Lettre sans voyelle qui rebondit ; plus nettement à l\'arrêt.</string>
    <string name="tajweed_madd_natural">Madd naturel</string>
    <string name="tajweed_madd_natural_body">Voyelle longue de deux temps.</string>
    <string name="tajweed_madd_munfasil">Madd séparé (munfaṣil)</string>
    <string name="tajweed_madd_munfasil_body">Voyelle longue en fin de mot devant la hamza du mot suivant : quatre ou cinq temps.</string>
    <string name="tajweed_madd_muttasil">Madd lié (muttaṣil)</string>
    <string name="tajweed_madd_muttasil_body">Voyelle longue devant une hamza dans le même mot : quatre ou cinq temps.</string>
    <string name="tajweed_madd_lazim">Madd obligatoire (lāzim)</string>
    <string name="tajweed_madd_lazim_body">Voyelle longue devant une lettre sans voyelle ou doublée : six temps.</string>
    <string name="tajweed_madd_arid">Madd de l\'arrêt (ʿāriḍ)</string>
    <string name="tajweed_madd_arid_body">Voyelle longue avant la dernière lettre, quand on s\'arrête : deux, quatre ou six temps.</string>
    <string name="tajweed_madd_lin">Madd līn</string>
    <string name="tajweed_madd_lin_body">و ou ي après une fatḥa, avant la dernière lettre à l\'arrêt : deux, quatre ou six temps.</string>
    <string name="tajweed_hamzat_wasl">Alif de liaison</string>
    <string name="tajweed_hamzat_wasl_body">Hamzat al-waṣl : ne se prononce que si l\'on commence par ce mot.</string>
    <string name="tajweed_lam_shamsiyyah">Lām solaire</string>
    <string name="tajweed_lam_shamsiyyah_body">Le lām de l\'article se fond dans la lettre solaire qui suit.</string>
    <string name="tajweed_silent">Lettre non lue</string>
    <string name="tajweed_silent_body">Écrite, non prononcée.</string>
    <string name="tajweed_tafkhim">Tafkhīm</string>
    <string name="tajweed_tafkhim_body">Lettre prononcée emphatique.</string>
    <string name="recite_tajweed">Tajwīd</string>
    <string name="recite_tajweed_body">Pendant que vous récitez, l\'app mesure combien de temps vous tenez les voyelles longues, par rapport à vos propres madd naturels : un madd de 4–5 ou de 6 temps qui ne dure pas plus qu\'un madd naturel est souligné. Vos arrêts sont pris en compte, et un madd tenu juste quatre temps n\'est jamais corrigé. Ce contrôle ne juge ni la ghunna, ni les points d\'articulation, ni l\'emphase, ni un madd trop long : la mesure du temps ne le permet pas lettre par lettre de façon fiable.</string>
    <string name="recite_tajweed_short45">Tenu %1$s s, comme vos madd naturels (%2$s s). Avant une hamza, la voyelle longue dure quatre ou cinq temps : au moins le double.</string>
    <string name="recite_tajweed_short6">Tenu %1$s s ; vos madd naturels durent %2$s s. Ce madd dure six temps : trois fois un madd naturel.</string>
    <string name="recite_tajweed_how">Mesuré sur votre récitation : le temps entre cette consonne et la suivante, comparé à vos voyelles longues ordinaires.</string>
    <string name="recite_tajweed_nothing">Aucune voyelle longue de 4 temps ou plus n\'a pu être mesurée (il faut des phrases récitées sans erreur, avec le nouveau modèle).</string>
    <string name="recite_tajweed_some">%1$d voyelles longues tenues sur %2$d</string>
    <plurals name="recite_tajweed_all">
        <item quantity="one">%d voyelle longue mesurée, tenue comme il faut</item>
        <item quantity="other">%d voyelles longues mesurées, toutes tenues comme il faut</item>
    </plurals>
